  {
   "key": "available",
   "title": "Available Works",
   "text": "Every painting on this site that isn’t marked sold is available directly from the studio. Prices are listed. Send a note with the title and I’ll reply with details, shipping, and a studio video of the piece."
  },
  {
   "key": "commissions",
   "title": "Commissions",
   "text": "A small number of commissions each year, usually 36\" and up. We start from a feeling, a place, or a person, and I share sketches before anything touches canvas."
  },
  {
   "key": "trade",
   "title": "Interior Designers + Trade",
   "text": "Working with designers, stagers, and hospitality projects that need original work at scale. Series can be placed together, and larger sizes are possible on request."
  },
  {
   "key": "studio",
   "title": "Studio Visits",
   "text": "The studio is in Miami and open by appointment. Come see the work in person, in daylight, before you decide."
  }
